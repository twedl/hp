#!/bin/sh
# hp: head for parquet files. Runs duckdb -c "FROM read_parquet(...)".
set -eu

usage() {
	cat <<'EOF'
Usage: hp [options] PATH...

Print parquet data with the duckdb CLI (v2.0.0+). PATH is a parquet file,
a folder (read as FOLDER/**/*.parquet), or a quoted glob.

  -n N         show the first N rows (default: the first 10 and last 10;
               with --glimpse, 5 values per column)
  --glimpse    one line per column: name, type, first values
  --all        show every column instead of collapsing the middle ones
  --partition  show hive partition columns (hidden by default)
  -h, --help   show this help
EOF
}

die() {
	echo "hp: $*" >&2
	exit 2
}

n= glimpse=false all=false hive=false paths=
while [ $# -gt 0 ]; do
	case $1 in
	-h | --help) usage; exit 0 ;;
	-n) [ $# -ge 2 ] || die "-n needs a number"; n=$2; shift ;;
	--glimpse) glimpse=true ;;
	--all) all=true ;;
	--partition) hive=true ;;
	-?*) die "unknown option: $1" ;;
	*)
		p=$1
		[ -d "$p" ] && p="${p%/}/**/*.parquet"
		paths="${paths:+$paths, }'$(printf %s "$p" | sed "s/'/''/g")'"
		;;
	esac
	shift
done
[ -n "$paths" ] || { usage >&2; exit 2; }
case $n in *[!0-9]*) die "-n must be a number, not '$n'" ;; esac
case $(duckdb -no-agent -version 2>/dev/null) in
v[2-9].* | v[1-9][0-9]*) ;;
*) die "needs duckdb v2.0.0 or newer" ;;
esac

src="read_parquet([$paths], hive_partitioning = $hive)"

if [ "$glimpse" = true ]; then
	width=0
	[ -t 1 ] && width=$(tput cols)
	exec duckdb -no-init -no-agent -list -noheader -c "
WITH s AS (FROM $src LIMIT ${n:-5}),
cols AS (
    SELECT row_number() OVER () AS i, column_name AS col, column_type AS type
    FROM (DESCRIBE FROM $src)
),
vals AS (
    UNPIVOT (SELECT row_number() OVER () AS __row, coalesce(COLUMNS(*)::VARCHAR, 'NULL') FROM s)
    ON COLUMNS(* EXCLUDE __row) INTO NAME col VALUE val
),
lines AS (
    SELECT 0 AS i, 'Rows: ' || (SELECT count(*) FROM $src) AS line
    UNION ALL
    SELECT 0.5, 'Columns: ' || count(*) FROM cols
    UNION ALL
    SELECT i, '\$ ' || rpad(col, (SELECT max(length(col)) FROM cols)::INT, ' ') || ' <' || type || '> '
              || coalesce(string_agg(val, ', ' ORDER BY __row), '')
    FROM cols LEFT JOIN vals USING (col)
    GROUP BY i, col, type
)
SELECT CASE WHEN $width > 0 AND length(line) > $width THEN left(line, $width - 1) || '…' ELSE line END
FROM lines ORDER BY i"
fi

maxrows=20 maxwidth=0 limit=
[ -n "$n" ] && maxrows=-1 limit="LIMIT $n"
[ "$all" = true ] && maxwidth=1000000
exec duckdb -no-init -no-agent -cmd ".maxrows $maxrows" -cmd ".maxwidth $maxwidth" -c "FROM $src $limit"
