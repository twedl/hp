#!/bin/sh
# hp: head for parquet files. Runs duckdb -c "FROM read_parquet(...) LIMIT 10".
set -eu

usage() {
	cat <<'EOF'
Usage: hp [options] PATH...

Print parquet data with the duckdb CLI (v2.0.0+). PATH is a parquet file,
a folder (read as FOLDER/**/*.parquet), or a quoted glob.

  -n N         show the first N rows (default 10; with --glimpse, N values
               per column, default 5)
  --glimpse    one line per column: name, type, first values (duckdb .columns)
  --all        show every column instead of collapsing the middle ones
  --partition  show hive partition columns (hidden by default)
  -h, --help   show this help
EOF
}

die() {
	echo "hp: $*" >&2
	exit 2
}

n= glimpse=false all=false hive=false paths=
while [ $# -gt 0 ]; do
	case $1 in
	-h | --help) usage; exit 0 ;;
	-n) [ $# -ge 2 ] || die "-n needs a number"; n=$2; shift ;;
	--glimpse) glimpse=true ;;
	--all) all=true ;;
	--partition) hive=true ;;
	-?*) die "unknown option: $1" ;;
	*)
		p=$1
		[ -d "$p" ] && p="${p%/}/**/*.parquet"
		paths="${paths:+$paths, }'$(printf %s "$p" | sed "s/'/''/g")'"
		;;
	esac
	shift
done
[ -n "$paths" ] || { usage >&2; exit 2; }
case $n in *[!0-9]*) die "-n must be a number, not '$n'" ;; esac
case $(duckdb -no-agent -version 2>/dev/null) in
v[2-9].* | v[1-9][0-9]*) ;;
*) die "needs duckdb v2.0.0 or newer" ;;
esac

src="read_parquet([$paths], hive_partitioning = $hive)"

# --glimpse uses duckdb's column-wise view: one line per column.
mode=.rows rows=10 maxwidth=0
[ "$glimpse" = true ] && mode=.columns rows=5
[ "$all" = true ] && maxwidth=1000000
exec duckdb -no-init -no-agent -cmd "$mode" -cmd ".maxrows -1" -cmd ".maxwidth $maxwidth" \
	-c "FROM $src LIMIT ${n:-$rows}"
